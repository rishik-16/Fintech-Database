# Environment variables for PayLedger
# Copy to .env and adjust as needed

# PostgreSQL
POSTGRES_USER=payledger_admin
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=payledger
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql://payledger_admin:changeme_in_production@db:5432/payledger
JWT_SECRET=change-this-to-a-random-64-char-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
KYC_HMAC_SECRET=change-this-to-a-random-secret-key-in-production
API_HOST=0.0.0.0
API_PORT=8000

# Web
VITE_API_URL=http://localhost:8000
